# .env.example
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ห้าม commit .env เข้า git เด็ดขาด

# =============================================================
# Google Service Account
# =============================================================
# อีเมล Service Account ที่ได้รับสิทธิ์เข้าถึง Spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Private Key ของ Service Account (เอา \n จริงใส่ หรือใช้ escaped \n)
# วิธี: ดาวน์โหลด JSON key จาก Google Cloud Console
#       แล้วเอา private_key field (ทั้ง BEGIN/END block) มาวาง
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# =============================================================
# Spreadsheet IDs
# =============================================================
# Spreadsheet หลัก (ออเดอร์ + ลูกค้า)
# ID: 1m1Cb_BEwPjqF3CgXNssGgjyewIgPNw_BU4EkduuV59U
SHEET_ID_ORDERS=1m1Cb_BEwPjqF3CgXNssGgjyewIgPNw_BU4EkduuV59U

# Spreadsheet สินค้า (Product_Master)
# ID: 1_qE1NtIfLfa2Vn0AXFxfGoD9daZB34OtLnv08Tc-o54
SHEET_ID_PRODUCTS=1_qE1NtIfLfa2Vn0AXFxfGoD9daZB34OtLnv08Tc-o54

# =============================================================
# JWT
# =============================================================
# Secret สำหรับ sign JWT token — ใช้ random string ยาวๆ
JWT_SECRET=change-me-to-a-long-random-secret-string

# =============================================================
# Server
# =============================================================
PORT=3000
